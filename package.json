{
  "name": "pact-directory",
  "version": "1.0.0",
  "workspaces": [
    "packages/*"
  ],
  "private": true,
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "pristine": "npm run clean --workspaces --if-present && rm -rf node_modules && rm -rf packages/*/node_modules"
  },
  "overrides": {
    "immutable": "^5.1.9",
    "brace-expansion": "5.0.8",
    "minimatch": "^10.2.4",
    "vite": "^6.4.3"
  }
}
